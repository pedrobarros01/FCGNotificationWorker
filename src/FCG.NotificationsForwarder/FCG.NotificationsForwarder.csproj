<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fcg-notifications-forwarder</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AssemblyName>FCG.NotificationsForwarder</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.6" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <!-- Submodulo FCG.Shared — mesmos contratos de evento usados pelos publishers -->
  <ItemGroup>
    <ProjectReference Include="..\submodule\FCG.Shared\FCG.Shared.csproj" />
  </ItemGroup>

</Project>
